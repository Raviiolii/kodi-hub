<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.villahub" name="VillaHub Repository" version="1.0.0" provider-name="Isaac">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="VillaHub Repository">
    <dir minversion="21.0.0">
      <info compressed="false">https://raw.githubusercontent.com/Raviiolii/kodi-hub/main/repo/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Raviiolii/kodi-hub/main/repo/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Raviiolii/kodi-hub/main/repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="es_MX">Repositorio de actualizaciones de VillaHub</summary>
    <summary lang="en_GB">VillaHub update repository</summary>
    <description lang="es_MX">Desde este repositorio se actualizan los addons y el paquete de configuracion del hub (menu, skin, favoritos).</description>
    <description lang="en_GB">This repository updates the VillaHub addons and configuration pack (menu, skin, favourites).</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
