<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.program.kubo" name="Kubo Updater" version="2.2.1" provider-name="Isaac">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="es_MX">Actualiza el hub (menu, skin, favoritos, addons)</summary>
    <summary lang="en_GB">Updates the hub (menu, skin, favourites, addons)</summary>
    <description lang="es_MX">Consulta el repositorio de Kubo y aplica la ultima configuracion del hub cuando el administrador publica una version nueva.</description>
    <description lang="en_GB">Checks the Kubo repository and applies the latest hub configuration when the administrator publishes a new version.</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="plugin.video.plutotv" version="1.6.3" name="Pluto TV" provider-name="Lunatixz">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.six" version="1.0.0"/>
        <import addon="script.module.kodi-six" version="0.1.3.1"/>
        <import addon="script.module.requests" version="2.7.0"/> 
        <import addon="script.module.simplecache" version="1.0.0"/>
        <import addon="script.module.routing" version="0.2.3"/>
        <import addon="script.module.inputstreamhelper" version="0.3.3"/>
        <import addon="service.iptv.manager" version="0.2.2" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="pseudotv_recommended.py"/>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>true</reuselanguageinvoker>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <source>https://github.com/Lunatixz/KODI_Addons/tree/master/plugin.video.plutotv</source>
        <website>http://pluto.tv/</website>
        <forum>http://forum.kodi.tv/showthread.php?tid=315513</forum>
        <news>v1.6.0a[CR]- TM Free LOGO[CR]</news>
        <broken>deprecated</broken>
        <assets>
            <icon>resources/images/icon.png</icon>
            <fanart>resources/images/fanart.jpg</fanart>
            <screenshot>resources/images/screenshot01.jpg</screenshot>
            <screenshot>resources/images/screenshot02.jpg</screenshot>
        </assets>   
        <summary lang="da_DK">Tv-kanaler dedikeret til dine yndlingsting, lavet af storfilm fra Paramount... &quot;Det geniale ved Pluto TV: dette er ægte internet-tv&quot;.</summary>
        <summary lang="es_MX">Pluto TV con parche Kubo (sesion jwt + UA navegador)</summary>
    <summary lang="en_GB">TV channels devoted to your favorite things, made from blockbuster movies from Paramount, ... “The genius of Pluto TV: This is real internet television”.</summary>
        <description lang="da_DK">Se gratis tv i Kodi! Stream Pluto TV&apos;s mere end 100 kanaler med nyheder, sport og internettets bedste, helt gratis på din Kodi-enhed.</description>
        <description lang="en_GB">Watch Free TV on Kodi! Stream Pluto TV&apos;s 100+ channels of news, sports, and the Internet&apos;s best, completely free on your Kodi device.</description>
    </extension>
</addon>
<addon id="repository.kubo" name="Kubo Repository" version="2.0.0" provider-name="Isaac">
  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>
  <extension point="xbmc.addon.repository" name="Kubo Repository">
    <dir minversion="21.0.0">
      <info compressed="false">https://raw.githubusercontent.com/Raviiolii/kubo/main/repo/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/Raviiolii/kubo/main/repo/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/Raviiolii/kubo/main/repo/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="es_MX">Repositorio de actualizaciones de Kubo</summary>
    <summary lang="en_GB">Kubo update repository</summary>
    <description lang="es_MX">Desde este repositorio se actualizan los addons y el paquete de configuracion del hub (menu, skin, favoritos).</description>
    <description lang="en_GB">This repository updates the Kubo addons and configuration pack (menu, skin, favourites).</description>
    <platform>all</platform>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="webinterface.kubo" name="Kubo UI" version="1.0.1" provider-name="Isaac">
  <requires>
    <import addon="xbmc.webinterface" version="1.0.1"/>
  </requires>
  <extension point="xbmc.webinterface" name="Kubo UI">
    <entry>index.html</entry>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="es_MX">Interfaz Kubo para el hub (abrela desde tu telefono)</summary>
    <summary lang="en_GB">Kubo UI for the hub (open it from your phone)</summary>
    <description lang="es_MX">Portada animada tipo Netflix que controla este Kodi: abre servicios, reproduce y actualiza el hub.</description>
    <platform>all</platform>
    <assets><icon>icon.png</icon></assets>
  </extension>
</addon>
</addons>
